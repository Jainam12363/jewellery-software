# Copy this file to .env and fill in the values before running.
PORT=3000
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-characters
NODE_ENV=development

# Neon PostgreSQL connection string (required)
# Get this from your Neon project dashboard → Connection Details
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Application base URL (used in password reset email links)
# Set to your production domain on Render, e.g. https://your-app.onrender.com
APP_BASE_URL=http://localhost:3000

# Sender address shown in password reset emails
SMTP_FROM=

# Brevo Transactional Email API key (required for forgot-password emails)
# Get from: Brevo dashboard → SMTP & API → API Keys → Generate a new API key
BREVO_API_KEY=
