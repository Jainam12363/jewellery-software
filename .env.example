# Copy this file to .env and fill in the values before running.
PORT=3000
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-characters
NODE_ENV=development

# Neon PostgreSQL connection string (required)
# Get this from your Neon project dashboard → Connection Details
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
