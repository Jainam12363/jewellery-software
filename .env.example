# Copy this file to .env and fill in the values before running.
PORT=3000
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-characters
NODE_ENV=development

# Neon PostgreSQL connection string (required)
# Get this from your Neon project dashboard → Connection Details
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Application base URL (used in password reset email links)
# Set to your production domain on Render, e.g. https://your-app.onrender.com
APP_BASE_URL=http://localhost:3000

# SMTP email configuration (required for forgot-password emails)
# Works with any SMTP provider: Gmail App Password, Brevo, Mailgun, Resend, etc.
# Example using Brevo (free tier: 300 emails/day, no domain verification needed):
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=your-brevo-login@example.com
#   SMTP_PASS=your-brevo-smtp-key
# Example using Gmail App Password:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your-gmail@gmail.com
#   SMTP_PASS=your-16-char-app-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: override the From address (defaults to SMTP_USER)
SMTP_FROM=
